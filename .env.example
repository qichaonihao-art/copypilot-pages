TIKHUB_API_KEY=replace-with-your-tikhub-key
TIKHUB_BASE_URL=https://api.tikhub.io
# 火山引擎语音识别新版控制台：填 APP Key
VOLCENGINE_API_KEY=replace-with-your-volcengine-key
# 火山引擎语音识别旧版控制台：填 APP ID + Access Token，Secret Key 当前接口不需要
VOLCENGINE_APP_ID=replace-with-your-volcengine-app-id
VOLCENGINE_ACCESS_TOKEN=replace-with-your-volcengine-access-token

# 阿里云 AI 工作台逐字稿接口代理。推荐使用专用外部接口：
# https://your-ai-workbench-domain.com/api/cp/external/transcribe-link
ALIYUN_TRANSCRIBE_API_URL=
ALIYUN_TRANSCRIBE_TOKEN=
ALIYUN_TRANSCRIBE_TIMEOUT_MS=480000
